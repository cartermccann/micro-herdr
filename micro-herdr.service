[Unit]
Description=micro-herdr — Codex Micro to herdr bridge (BLE HID vendor events -> shell bindings)

[Service]
Type=simple
# Adjust the path if you cloned elsewhere. %h = your home directory.
WorkingDirectory=%h/projects/micro-herdr
ExecStart=/usr/bin/env node %h/projects/micro-herdr/micro-herdrd.mjs
ExecReload=/usr/bin/env kill -HUP $MAINPID
# Point this at the wl-device-kit inside your Work Louder Input install:
# Environment=MICRO_HERDR_KIT=%h/path/to/@worklouder/wl-device-kit/dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
